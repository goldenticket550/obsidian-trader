# Copy this file to .env.local and fill in real values.
# Nothing here is required to run Phase 1 (it uses mock data only).

# --- Supabase (Phase 6: auth + persistent watchlist/settings) ---
# Leave these unset to keep running exactly like Phases 1-5 (hardcoded
# mock watchlist, no login required). Once both are set, the app requires
# sign-in and uses your real, per-user watchlist and strategy config.
#
# Setup:
# 1. Create a free project at https://supabase.com
# 2. Project Settings -> API -> copy the URL and anon/public key below
# 3. SQL Editor -> paste and run supabase/migrations/0001_watchlist_and_config.sql
# 4. Authentication -> URL Configuration -> add http://localhost:3000/auth/callback
#    as a redirect URL (and your production URL later, when you deploy)
# 5. Authentication -> Providers -> Email is enabled by default; magic-link
#    sign-in (no password) is what this app uses
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Public site URL (auth redirects) ---
# The canonical, externally-reachable URL of THIS deployment, e.g.
# https://obsidian-trader.vercel.app (production) — NO trailing slash.
# Used to build the magic-link redirect so it never points at localhost in
# production. Leave UNSET locally: the app then uses http://localhost:3000.
# MUST be https in production and MUST also be set as the Supabase
# Authentication -> URL Configuration "Site URL" (and its /auth/callback
# added to "Redirect URLs"), or Supabase will fall back to its Site URL and
# the localhost-redirect bug returns. It is public by design (no secret).
NEXT_PUBLIC_SITE_URL=

# --- Background scanning (Phase 6d) ---
# Required for /api/cron/scan to run at all — the route refuses to
# execute with no secret configured, rather than allowing an
# unauthenticated request to trigger a scan of every user's data.
# Generate any long random string (e.g. `openssl rand -hex 32`).
# On Vercel: set this in Project Settings -> Environment Variables, and
# Vercel automatically sends it as the Authorization header for its own
# cron-triggered requests. If using an external scheduler instead (see
# README — Vercel's free Hobby tier only allows daily cron), configure
# that scheduler to send `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=

# --- AI explanations (Phase 7) ---
# Leave unset to run without AI features — every button that needs this
# shows a clear "not configured" message instead of failing silently.
# Get a key at https://console.anthropic.com (a separate key from
# anything else in this project — this is the Claude API, billed
# separately from any Claude.ai subscription).
ANTHROPIC_API_KEY=
# Optional override. Defaults to claude-sonnet-5. Use
# claude-haiku-4-5-20251001 for a cheaper/faster alternative.
AI_MODEL=

# Leave these unset to run on mock/simulated data (default, no signup needed).
# Get free keys at https://alpaca.markets after creating a (free, no funding
# required) account. Never prefix these with NEXT_PUBLIC_ — they must stay
# server-side only; the /api/scan route reads them, the browser never does.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
# "iex" (default, free real-time single-exchange feed) or "sip" (full
# consolidated tape; 15-min delayed unless ALPACA_PAID_PLAN=true).
ALPACA_FEED=iex
ALPACA_PAID_PLAN=false

# --- OBSIDIAN Core reporting (server-only; Stage B) ---
# Signals are first persisted to the local outbox. A Core outage never fails a scan.
OBSIDIAN_CORE_INGEST_URL=
OBSIDIAN_CORE_KEY_ID=
OBSIDIAN_CORE_REPORTING_KEY=
